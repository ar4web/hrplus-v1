{
  "name": "hrplus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:api": "node --import ./dev/register.mjs dev/server.mjs",
    "dev:all": "node dev/run.mjs",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true});console.log('local database cleared')\"",
    "db:seed": "node --import ./dev/register.mjs -e \"import('./dev/bootstrap.mjs').then(m=>m.ensureSeeded({log:console.log})).then(r=>console.log(r))\"",
    "test:api": "node dev/api-test.mjs",
    "test:e2e": "node dev/smoke.mjs",
    "test": "npm run test:unit && node dev/api-test.mjs",
    "test:all": "npm run test:api && npm run test:e2e && npm run test:unit && npm run test:seed && npm run test:rls",
    "test:unit": "node dev/unit/build-fixtures.mjs && node dev/unit/format-test.mjs && node dev/unit/docx-test.mjs && node dev/unit/zatca-test.mjs && node dev/unit/googleauth-test.mjs",
    "test:schema": "psql \"$DATABASE_URL\" -q -v ON_ERROR_STOP=1 -f supabase/migrations/0001_init.sql && node dev/check-schema.mjs",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/migrations/0001_init.sql -f supabase/migrations/0002_storage.sql",
    "test:rls": "node dev/check-rls.mjs",
    "test:seed": "node dev/run-seed-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "@tailwindcss/vite": "^4.2.1",
    "framer-motion": "^12.35.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.65.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}

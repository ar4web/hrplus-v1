# Frontend (Vite) — exposed to the browser
VITE_DEMO_MODE=1                      # 1 = run the local API emulator in /dev, 0 = use Supabase
VITE_DEMO_API_URL=http://127.0.0.1:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# Backend (Vercel serverless functions in /api) — server only, never expose
NEXT_PUBLIC_SUPABASE_URL=             # same project URL as VITE_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FULLSTACK_PROJECT_REF=
FULLSTACK_RESTORE_API_URL=

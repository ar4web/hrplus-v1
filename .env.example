# =============================================================================
# HRplus environment variables
# Copy this file to .env.local (dev) or set these in your hosting dashboard
# (Vercel Project Settings > Environment Variables) for production.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite) — exposed to the browser
# Prefix with VITE_ so Vite inlines them at build time.
# -----------------------------------------------------------------------------

# Demo mode: 1 = local API emulator (no cloud needed), 0 = real Supabase
VITE_DEMO_MODE=0

# Local emulator API URL (only used when VITE_DEMO_MODE=1)
VITE_DEMO_API_URL=http://127.0.0.1:8787

# Supabase project URL — required for production
VITE_SUPABASE_URL=

# Supabase anon (public) key — required for production
VITE_SUPABASE_ANON_KEY=

# Optional: Google sign-in
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=

# -----------------------------------------------------------------------------
# Backend (Vercel serverless functions in /api) — server only
# Set these in your hosting dashboard (never commit real values).
# -----------------------------------------------------------------------------

# Supabase project URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=

# Supabase service role key — full database access, server only
SUPABASE_SERVICE_ROLE_KEY=

# Optional: seed token for one-time bootstrap (POST /api/seed)
SEED_TOKEN=

# Optional: restore API URL for backup restore from another environment
FULLSTACK_RESTORE_API_URL=
